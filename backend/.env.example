# Non-secret Google Cloud Run configuration (NEVER put Meta secrets or tokens here)
PORT=8080
GCP_PROJECT_ID=your-gcp-project-id
META_GRAPH_VERSION=v21.0
# Names of Google Cloud Secret Manager secrets (stored encrypted in GCP Secret Manager)
SECRET_META_ACCESS_TOKEN=reachhub-meta-access-token
SECRET_META_APP_SECRET=reachhub-meta-app-secret
SECRET_META_WEBHOOK_VERIFY_TOKEN=reachhub-meta-webhook-verify-token
SECRET_META_WABA_ID=reachhub-meta-waba-id
SECRET_META_PHONE_MAP_JSON=reachhub-meta-phone-map-json
SECRET_BOOTSTRAP_REGISTRATION_TOKEN=reachhub-bootstrap-registration-token

# Operational safety settings
CLOUD_TASKS_CONFIGURED=true
ALLOWED_TIMESTAMP_SKEW_SECONDS=300
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=240
FIRESTORE_COLLECTION_PREFIX=reachhub
